<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome layer for themed icons (Android 13+). The launcher tints this
    drawable, so only alpha matters - every shape is solid white.

    The painted foreground is a raster and cannot be re-tinted, so this is a
    hand-drawn reduction of it: the card and the prompt, with the gear, the code
    brackets, the bolt and the card stack dropped because they collapse into a
    blob once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:pathData="M30,40 a8,8 0 0 1 8,-8 h32 a8,8 0 0 1 8,8 v28 a8,8 0 0 1 -8,8 h-32 a8,8 0 0 1 -8,-8 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4" />

    <path
        android:pathData="M41,47 L51,55 L41,63"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5.5" />
    <path
        android:pathData="M56,63 H68"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5.5" />
</vector>
