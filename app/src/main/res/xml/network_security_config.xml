<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        No cleartext exemptions.

        This file previously permitted cleartext to 127.0.0.1/localhost on the
        assumption that the ADB client needed it. It does not: the ADB transport is
        a raw java.net.Socket (adb/AdbClient.kt socketFactory, adb/PortScanner.kt
        tryPort), and network-security-config only governs the HTTP/TLS stacks
        (HttpURLConnection, WebView, Cronet) — a raw Socket is unaffected. So the
        exemption was dead config that served only as a footgun: a future loopback
        HTTP call would have been permitted, letting a malicious local listener
        answer it.

        Every actual HTTP client in the app is https with platform-default trust:
          config/GachaApi.kt       -> gmserver-api.aki-game2.{com,net}
          update/UpdateManager.kt -> api.github.com + the release asset
        The WebView loads a local asset with a synthetic https base URL.
    -->
</network-security-config>
