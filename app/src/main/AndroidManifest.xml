<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- AdbConnectionService holds a PARTIAL_WAKE_LOCK for the lifetime of the
         wireless-ADB session. A dataSync FGS does NOT exempt the app from
         Doze/suspend, so without this the socket can die silently while the
         "ADB connection active" notification is still up. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
<!-- POST_NOTIFICATIONS is a runtime permission on API 33+, requested by
         MainActivity.requestNotificationPermissionIfNeeded() from onCreate().
         It is declared here and requested there; that is the whole story, and
         the request must stay in MainActivity because it is the only
         top-of-stack Activity — it cannot live in the Application class or in
         a Service. Without it the AdbConnectionService foreground notification
         is silently suppressed and the user has no way to stop an active
         privileged ADB session. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (API 30+). UpdateManager.openForInstall() calls
         resolveActivity() on an ACTION_VIEW + package-archive intent; without
         this element the system installer is invisible and the self-update flow
         reports the misleading "No package installer found on device" on a
         device that installs APKs perfectly well. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".WuWaConfigApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WuWaConfig"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WuWaConfig"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Required by the Shizuku host (reflective instantiate). Do NOT set
             exported=false.

             android:permission is NOT optional here. ShizukuProvider.call()
             performs NO caller check of any kind — verified by disassembling
             dev.rikka.shizuku:provider:13.1.5 (zero checkCallingPermission /
             enforceCallingPermission / getCallingUid references). Without this
             attribute, ANY installed app can:

               1. call("getBinder") and walk away with the live Shizuku server
                  IBinder, and enumerate which packages hold Shizuku;
               2. call("sendBinder") with an attacker-controlled IShizukuService
                  while our binder is not yet pushed. bindUserService then hands
                  ShizukuBackend a ShellServiceProxy over THAT object, so every
                  shell command, every base64 of the generated INI, and every
                  Client.log read is delivered to the attacker, while the MD5 /
                  size "verification" becomes attacker-controlled too.

             INTERACT_ACROSS_USERS_FULL is signature|privileged and held by
             com.android.shell (uid 2000) but by no normal app, so the Shizuku
             server can still push the binder while every third-party app is
             blocked at the platform level. This is the attribute Shizuku's own
             setup documentation requires. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:multiprocess="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.AdbConnectionService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Hosted by Shizuku's UserService mechanism, not bound by the system. Keep exported=false. -->
        <service
            android:name=".service.ShellUserService"
            android:exported="false" />

        <!-- AppFunctions: the system-agent callable surface. The class named here is the one
             KSP generates from @AppFunctionServiceEntryPoint on BaseWuWaAppFunctionService,
             together with the assets schema XML named in the `v2` property. Both must be
             declared by hand; the annotation only produces them.

             android:permission is load-bearing and NOT optional, for the same reason
             ShizukuProvider's is above: BIND_APP_FUNCTION_SERVICE is what stops an
             arbitrary installed app from executing this app's functions. Every function
             exposed here is read-only or in-memory (see BaseWuWaAppFunctionService), so the
             blast radius of a leak is the user's cached profile, deploy history and the app's
             config generator — the account identifier in battle statistics and the
             redacted-config internals are withheld, but that is defence in depth, not the
             control. Do not set exported="false": the system is the caller. -->
        <service
            android:name="com.wuwaconfig.app.appfunctions.WuWaConfigAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="wuwaconfig_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <!-- App-wide description the system agent reads alongside the per-function
             metadata. Cross-function sequencing and constraints only; per-function
             behaviour lives in the KDoc that KSP lifts into the generated schema. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

    </application>

</manifest>
